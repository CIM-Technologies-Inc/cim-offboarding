APP_NAME="CIM Offboarding"
APP_ENV=production
# Leave empty to let the container generate and keep a key on first start.
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cim_offboarding
DB_USERNAME=cim_offboarding
# docker-compose.yml passes MYSQL_APP_PASSWORD to both MySQL and the app as
# DB_PASSWORD, so set the passwords here. MySQL only applies them when its
# data volume is first created.
MYSQL_APP_PASSWORD=change-this-database-password
MYSQL_ROOT_PASSWORD=change-this-root-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=your-smtp-host
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=offboarding@example.com
MAIL_FROM_NAME="${APP_NAME}"

RUN_MIGRATIONS=true

# Create the default admin (admin / 123456) on first start when no admin exists.
SEED_ADMIN=true
